{
    "name": "@steel-dev/mcp-server",
    "version": "0.8.0",
    "description": "MCP server for browser automation using Steel and Playwright (custom fork with list-page scraping + bot detection)",
    "license": "MIT",
    "author": "Steel (https://steel.dev)",
    "homepage": "https://steel.dev",
    "bugs": "https://github.com/steel-dev/mcp-server/issues",
    "type": "module",
    "bin": {
        "mcp-server-steel": "dist/index.cjs"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "bun build src/index.ts --outdir dist --target=node --format=cjs --external patchright --external patchright-core && mv dist/index.js dist/index.cjs",
        "dev": "bun --watch src/index.ts",
        "start": "node dist/index.cjs",
        "lint": "oxlint src/",
        "format": "oxfmt --write src/",
        "format:check": "oxfmt --check src/",
        "test": "bun test src/__tests__/",
        "inspector": "bunx @modelcontextprotocol/inspector bun src/index.ts"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.32.2",
        "@mozilla/readability": "^0.6.0",
        "@napi-rs/image": "^1.16.0",
        "dotenv": "^18.0.9",
        "impit": "0.14.8",
        "linkedom": "^0.18.15",
        "mime-types": "^3.0.2",
        "patchright": "1.64.3",
        "steel-sdk": "^0.18.0",
        "tldts": "7.4.19",
        "turndown": "^7.2.5",
        "ws": "8.20.1",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@modelcontextprotocol/inspector": "^0.21.2",
        "@types/bun": "^1.3.14",
        "@types/mime-types": "^3.0.1",
        "@types/turndown": "^5.0.6",
        "@types/ws": "8.18.2",
        "oxfmt": "^0.57.0",
        "oxlint": "^1.72.0",
        "shx": "^0.4.0",
        "typescript": "^6.0.3"
    },
    "packageManager": "bun@1.3.14"
}
