{
    "name": "@steel-dev/mcp-server",
    "version": "0.7.0",
    "description": "MCP server for browser automation using Steel and Playwright (custom fork with list-page scraping + bot detection)",
    "license": "MIT",
    "author": "Steel (https://steel.dev)",
    "homepage": "https://steel.dev",
    "bugs": "https://github.com/steel-dev/mcp-server/issues",
    "type": "module",
    "bin": {
        "mcp-server-steel": "dist/index.cjs"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "bun build src/index.ts --outfile dist/index.cjs --target=node --format=cjs --external @napi-rs/image --external patchright",
        "dev": "bun --watch src/index.ts",
        "start": "node dist/index.cjs",
        "lint": "oxlint src/",
        "format": "oxfmt --write src/",
        "format:check": "oxfmt --check src/",
        "test": "bun test src/__tests__/",
        "inspector": "bunx @modelcontextprotocol/inspector bun src/index.ts"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.29.0",
        "@mozilla/readability": "^0.6.0",
        "@napi-rs/image": "^1.14.0",
        "dotenv": "^17.4.2",
        "linkedom": "^0.18.12",
        "mime-types": "^3.0.2",
        "patchright": "^1.61.1",
        "steel-sdk": "^0.18.0",
        "turndown": "^7.2.4",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@modelcontextprotocol/inspector": "^0.21.2",
        "@types/bun": "^1.3.14",
        "@types/mime-types": "^3.0.1",
        "@types/turndown": "^5.0.6",
        "oxfmt": "^0.57.0",
        "oxlint": "^1.72.0",
        "shx": "^0.4.0",
        "typescript": "^6.0.3"
    },
    "packageManager": "bun@1.3.14"
}
